# =============================================================================
# Twitch Emote Generator — 環境変数テンプレート
# =============================================================================
#
# このファイルは設定値の構造を示すサンプル。実値は `.env.local`（git 管理外）
# または Vercel 環境変数で管理する。
#
# 値の入手:
#   - PASSPHRASE: Aki が任意設定（合言葉解放用）
#   - AUTH_*: Twitch Developer Console (https://dev.twitch.tv/console/apps)
#   - AUTH_TWITCH_BROADCASTER_ID: Twitch Helix /users で datsusara_aki の id を取得
#
# 2026-09（コミット A）で SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / ANTHROPIC_API_KEY は
# 廃止。アプリはどちらのサービスにも接続しない（設定しても読まれない）。
# =============================================================================


# --- Authentication ---

# 合言葉（解放経路の一つ）。サーバーのみで照合（空白除去・大小文字無視、512 文字以内）
PASSPHRASE=

# R1b: 合言葉 Cookie（emote-access-v1）の署名用専用鍵。32 文字以上の乱数。
# `openssl rand -base64 48` で生成。AUTH_SECRET とは別にする。
# この値または PASSPHRASE を変えると発行済み Cookie は全て失効する（再入力が必要）。
# 試行制限のキー（IP の HMAC）の派生元にも使う。試行制限はインスタンス内メモリの
# ベストエフォート（複数インスタンス横断・再起動後の持続はしない）。
PASSPHRASE_COOKIE_SECRET=

# R1b（任意）: 変更系 API の Origin 検証で許可する追加オリジン（カンマ区切り）。
# 未設定ならリクエスト URL 自身のオリジンのみ許可。
APP_ORIGIN=

# Auth.js (next-auth) のセッション暗号化キー。`openssl rand -base64 32` で生成
AUTH_SECRET=

# ローカルで `next start`（本番モード）を試すときだけ true にする。Vercel では VERCEL 環境変数で自動的に信頼される
# AUTH_TRUST_HOST=true

# Twitch Developer Console で取得した OAuth アプリの Client ID / Secret
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=

# fix7: フォロー判定対象のチャンネル user_id（Aki = datsusara_aki の数値ID）
# 設定が無い場合 isFollower=false 固定（safe fallback）
AUTH_TWITCH_BROADCASTER_ID=


# --- killswitch（R1b で意味を固定、実装設計 §9） ---
#
# 受け付ける値: true/1/yes/on, false/0/no/off（大小文字無視）。
# それ以外の値は警告ログを出して既定値扱い（黙って true にしない）。
#
# 問題時の戻し方（軽症 → 重症）:
#   1. FOLLOW_AUTH_ENABLED=false   → フォロー経路停止、署名済み合言葉のみ
#   2. DOWNLOAD_LOCK_ENABLED=false → 保存の権限ゲートのみ解除（入力検証は維持）
#   3. SITE_LOCK_ENABLED=false     → ゲート撤去（未解放は trial 制限で利用可）
#   4. TRIAL_MODE_ENABLED=false    → 解放を全許可（緊急設定）
# 署名なし Cookie を信頼する旧コードへの単純 rollback は復旧策にしない。

# サイト全体ロック。true で未解放の新規アクセスはゲート画面（フォロー or 合言葉）
SITE_LOCK_ENABLED=true

# false は明示的な全解放の緊急設定
TRIAL_MODE_ENABLED=true

# フォロー経路の許可。コード既定値は false（段階公開）。本番で true を明示して有効化
FOLLOW_AUTH_ENABLED=true

# deprecated: 現コードで実効なし。互換のため読み取るだけ（運用対象外）
PREMIUM_LOCK_ENABLED=true

# false はアプリの保存権限ゲートのみ解除。サイズ・形式の入力検証は維持
DOWNLOAD_LOCK_ENABLED=true
